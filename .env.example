# --- Variables de SERVIDOR (sin prefijo VITE_) ---
# Las usa api/existencias.js, que corre en el servidor de Vercel y actúa
# como intermediario hacia tu API real, evitando el bloqueo de CORS del
# navegador. Configúralas en Vercel -> Settings -> Environment Variables.
EXISTENCIAS_API_URL=https://sam.madecentro.com/APIS/WebApiNode_TRASLADOS_INVENTARIO
EXISTENCIAS_API_TOKEN=

# --- Variables de CLIENTE (con prefijo VITE_, quedan en el navegador) ---
# Proyecto Supabase (gratis): https://supabase.com -> New Project
# Los encuentras en Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
